#include <winver.h>
1 24 "fnvr_voice.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,2,0,1
PRODUCTVERSION 2,2,0,1
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "FNVVRMC (github.com/LIME99902/Fallout-New-Vegas-VR)"
      VALUE "FileDescription", "FNVVRMC offline voice commands helper (Vosk speech recognition)"
      VALUE "FileVersion", "2.2.0.1"
      VALUE "InternalName", "FNVR_Voice"
      VALUE "LegalCopyright", "Open source - FNVVRMC Fallout New Vegas VR mod"
      VALUE "OriginalFilename", "FNVR_Voice.exe"
      VALUE "ProductName", "FNVVRMC - Fallout: New Vegas VR"
      VALUE "ProductVersion", "2.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
